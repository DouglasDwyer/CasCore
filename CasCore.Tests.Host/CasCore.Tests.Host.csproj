<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasCore.Tests.Shared\CasCore.Tests.Shared.csproj" />
    <ProjectReference Include="..\CasCore.Tests.Cil\CasCore.Tests.Cil.ilproj" />
    <ProjectReference Include="..\CasCore.Tests.Csharp\CasCore.Tests.Csharp.csproj" />
    <ProjectReference Include="..\CasCore\CasCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The net6.0 build of Newtonsoft.Json, which (unlike the netstandard2.0 build referenced above)
         uses System.Reflection.Emit for dynamic code generation unless RuntimeFeature.IsDynamicCodeSupported
         reports false. Loaded by file path at runtime to verify this build is also sandboxable. -->
    <None Include="Newtonsoft.Json.Modern.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
